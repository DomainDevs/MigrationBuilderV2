{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataToolkit": {
    "Logging": {
      "Enabled": true
    },
    "Telemetry": {
      "Enabled": true,
      "SlowMs": 500
    },
    "Retry": {
      "Enabled": true,
      "MaxRetries": 3,
      "BaseDelayMs": 200
    }
  }
}
